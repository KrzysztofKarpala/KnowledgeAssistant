DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/knowledge_assistant
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-e4b
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-qat
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=60
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.3
RERANKER_ENABLED=true
RERANKER_BASE_URL=http://host.docker.internal:8081/v1
RERANKER_MODEL=gpustack/bge-reranker-v2-m3-GGUF:Q4_K_M
RERANKER_TIMEOUT_SECONDS=30
RERANKER_CANDIDATE_LIMIT=50
